# Runtime server (Supavisor pooler, transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# drizzle-kit migrate (koneksi langsung / session mode, port 5432)
DATABASE_URL_MIGRATE=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
