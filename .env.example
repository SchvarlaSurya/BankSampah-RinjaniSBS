# Runtime server: role app_server lewat Supavisor, transaction mode (port 6543).
# Username pooler untuk custom role: <role>.<project-ref>
DATABASE_URL=postgresql://app_server.<project-ref>:<password-app_server>@<pooler-host>:6543/postgres

# drizzle-kit migrate: role owner (postgres), koneksi langsung (port 5432, IPv6 kecuali ada add-on IPv4).
# Alternatif IPv4: session pooler postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL_MIGRATE=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Better Auth. Secret acak >= 32 karakter, mis. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=<acak-minimal-32-karakter>
# URL publik aplikasi (produksi: https://...). Cookie Secure otomatis di NODE_ENV=production.
BETTER_AUTH_URL=http://localhost:3000
# Origin tambahan yang dipercaya, dipisah koma (opsional).
TRUSTED_ORIGINS=

# Foto timbangan. Produksi WAJIB "supabase" (disk serverless tidak permanen); "local" untuk dev/tes.
FOTO_STORAGE=local
# Hanya untuk FOTO_STORAGE=local (default .data/foto, sudah di .gitignore).
FOTO_LOCAL_DIR=.data/foto
# Hanya untuk FOTO_STORAGE=supabase. Service role key HANYA di server, jangan pernah NEXT_PUBLIC_.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Bucket PRIVATE.
FOTO_BUCKET=foto-timbangan
# Bucket PRIVATE foto profil (semua role). Mode local: <FOTO_LOCAL_DIR>/profil.
FOTO_PROFIL_BUCKET=foto-profil

# Cron keepalive harian (GET /api/cron/keepalive, dijadwalkan di vercel.json). Vercel Cron mengirim
# header "Authorization: Bearer <CRON_SECRET>" otomatis. Acak >= 16 karakter. Kosong = endpoint 503.
CRON_SECRET=

# Hanya untuk `npm run seed:superadmin` (bootstrap super_admin pertama).
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_NAMA=
# Hanya untuk `npm run reset:superadmin` (darurat: super_admin lupa password).
RESET_SUPERADMIN_USERNAME=
